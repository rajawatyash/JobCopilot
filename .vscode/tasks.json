{
  "version": "2.0.0",
  "tasks": [
    {
      // Runs before F5, so the debugger always launches the code you just edited.
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/JobCopilot.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/JobCopilot.slnx"],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
